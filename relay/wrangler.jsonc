{
  // Your own relay, in your own Cloudflare account. See docs/official-source.md.
  "name": "picode-whatsapp-relay",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "picode-whatsapp-relay", "database_id": "REPLACE_WITH_YOUR_DATABASE_ID" }
  ],
  // Removes what this computer never came back for.
  "triggers": { "crons": ["17 4 * * *"] }
}
